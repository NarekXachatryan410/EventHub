generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  EVENT_MANAGER
  CHECK_IN_STAFF
}

enum EventType {
  OPEN_DAY
  WORKSHOP
  INFORMATION_SESSION
  GUEST_VISIT
  MEETUP
  GRADUATION_CEREMONY
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLISTED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
  INVALID
}

enum EmailType {
  REGISTRATION_CONFIRMATION
  WAITLIST_CONFIRMATION
  EVENT_REMINDER
  REGISTRATION_CANCELLATION
  EVENT_CANCELLATION
  POST_EVENT_THANK_YOU
  FEEDBACK_REQUEST
  EVENT_MATERIALS
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  DELIVERY_DELAYED
  BOUNCED
  COMPLAINED
  SUPPRESSED
  FAILED
  CANCELLED
}

enum PlanningTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum CrmCustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CrmActivityType {
  CUSTOMER_CREATED
  CUSTOMER_UPDATED
  REGISTRATION_CREATED
  TICKET_CANCELLED
  CHECKED_IN
  ATTENDED
  NOTE_ADDED
  REMINDER_CREATED
  REMINDER_COMPLETED
  COMMUNICATION_RECORDED
}

enum CrmReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CrmCommunicationChannel {
  EMAIL
  PHONE_CALL
  MEETING
  OTHER
}

enum CrmCommunicationDirection {
  INBOUND
  OUTBOUND
}

enum CrmCommunicationStatus {
  RECORDED
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  firstName                String
  lastName                 String
  email                    String                 @unique
  passwordHash             String
  role                     UserRole               @default(EVENT_MANAGER)
  isActive                 Boolean                @default(true)
  events                   Event[]                @relation("EventOrganizer")
  checkIns                 CheckIn[]
  assignedEvents           EventStaffAssignment[]
  assignedPlanningTasks    PlanningTask[]         @relation("PlanningTaskAssignee")
  createdPlanningTemplates PlanningTemplate[]     @relation("PlanningTemplateCreator")
  auditLogs                AuditLog[]
  crmCustomers             CrmCustomer[]           @relation("CrmCustomerOrganizer")
  crmCustomerNotes         CrmCustomerNote[]       @relation("CrmCustomerNoteAuthor")
  crmCustomerActivities    CrmCustomerActivity[]   @relation("CrmCustomerActivityActor")
  crmCustomerTags          CrmCustomerTag[]        @relation("CrmCustomerTagOrganizer")
  crmSegments              CrmCustomerSegment[]    @relation("CrmCustomerSegmentOrganizer")
  crmSegmentsCreated       CrmCustomerSegment[]    @relation("CrmCustomerSegmentCreator")
  crmRemindersCreated      CrmCustomerReminder[]   @relation("CrmCustomerReminderCreator")
  crmRemindersAssigned     CrmCustomerReminder[]   @relation("CrmCustomerReminderAssignee")
  crmCommunications        CrmCommunicationRecord[] @relation("CrmCommunicationCreator")
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)

  @@index([role, isActive])
}

model Event {
  id                    String                  @id @default(uuid()) @db.Uuid
  title                 String
  slug                  String                  @unique
  description           String
  coverImage            String?
  type                  EventType
  status                EventStatus             @default(DRAFT)
  location              String
  startDate             DateTime                @db.Timestamptz(6)
  endDate               DateTime                @db.Timestamptz(6)
  registrationDeadline  DateTime                @db.Timestamptz(6)
  maxAttendees          Int?
  organizerId           String                  @db.Uuid
  organizer             User                    @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  contactEmail          String?
  seoTitle              String?
  seoDescription        String?
  registrationEnabled   Boolean                 @default(true)
  allowSelfCancellation Boolean                 @default(true)
  registrationQuestions Json?
  reminderOffsetsHours  Int[]                   @default([24, 2])
  registrations         EventRegistration[]
  feedback              Feedback[]
  crmActivities         CrmCustomerActivity[]
  staffAssignments      EventStaffAssignment[]
  planningChecklist     EventPlanningChecklist?
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)

  @@index([status, startDate])
}

model EventRegistration {
  id                    String             @id @default(uuid()) @db.Uuid
  eventId               String             @db.Uuid
  event                 Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  email                 String
  normalizedEmail       String
  cancellationTokenHash String?            @unique
  phone                 String?
  organization          String?
  interestedInPrograms  Boolean?
  additionalAnswers     Json?
  status                RegistrationStatus @default(PENDING)
  marketingConsent      Boolean            @default(false)
  registeredAt          DateTime           @default(now()) @db.Timestamptz(6)
  ticket                Ticket?
  emailLogs             EmailLog[]
  feedback              Feedback?
  crmCustomerId         String?            @db.Uuid
  crmCustomer           CrmCustomer?       @relation(fields: [crmCustomerId], references: [id], onDelete: SetNull)

  @@unique([eventId, normalizedEmail])
  @@index([eventId, status])
  @@index([eventId, registeredAt])
  @@index([crmCustomerId, registeredAt])
}

model Ticket {
  id                String            @id @default(uuid()) @db.Uuid
  registrationId    String            @unique @db.Uuid
  registration      EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash         String            @unique
  feedbackTokenHash String?           @unique
  status            TicketStatus      @default(VALID)
  checkIn           CheckIn?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
}

model CheckIn {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @unique @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  checkedInBy String   @db.Uuid
  staff       User     @relation(fields: [checkedInBy], references: [id], onDelete: Restrict)
  checkedInAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([checkedInBy, checkedInAt])
}

model EmailLog {
  id                String            @id @default(uuid()) @db.Uuid
  registrationId    String?           @db.Uuid
  registration      EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  templateId        String?           @db.Uuid
  template          EmailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  type              EmailType
  status            EmailStatus       @default(PENDING)
  idempotencyKey    String?           @unique
  providerId        String?
  payloadCiphertext String?
  attempts          Int               @default(0)
  scheduledAt       DateTime          @default(now()) @db.Timestamptz(6)
  lastAttemptAt     DateTime?         @db.Timestamptz(6)
  sentAt            DateTime?         @db.Timestamptz(6)
  errorMessage      String?
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)

  @@index([registrationId, type, status])
  @@index([status, scheduledAt])
  @@index([providerId])
}

model EmailTemplate {
  id        String     @id @default(uuid()) @db.Uuid
  type      EmailType  @unique
  subject   String
  html      String
  text      String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  emailLogs EmailLog[]
}

model Feedback {
  id                   String            @id @default(uuid()) @db.Uuid
  eventId              String            @db.Uuid
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId       String            @unique @db.Uuid
  registration         EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  overallRating        Int
  contentRating        Int?
  organizationRating   Int?
  comment              String?
  interestedInPrograms Boolean?
  submittedAt          DateTime          @default(now()) @db.Timestamptz(6)
}

model EventStaffAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffId    String   @db.Uuid
  staff      User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([eventId, staffId])
  @@index([staffId])
}

model PlanningTemplate {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  eventType   EventType
  isSystem    Boolean                  @default(false)
  createdById String?                  @db.Uuid
  createdBy   User?                    @relation("PlanningTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks       PlanningTemplateTask[]
  checklists  EventPlanningChecklist[]
  createdAt   DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(6)

  @@index([eventType, isSystem])
}

model PlanningTemplateTask {
  id              String           @id @default(uuid()) @db.Uuid
  templateId      String           @db.Uuid
  template        PlanningTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  daysBeforeEvent Int?
  position        Int              @default(0)

  @@index([templateId, position])
}

model EventPlanningChecklist {
  id         String            @id @default(uuid()) @db.Uuid
  eventId    String            @unique @db.Uuid
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateId String?           @db.Uuid
  template   PlanningTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks      PlanningTask[]
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)
}

model PlanningTask {
  id           String                 @id @default(uuid()) @db.Uuid
  checklistId  String                 @db.Uuid
  checklist    EventPlanningChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedToId String?                @db.Uuid
  assignedTo   User?                  @relation("PlanningTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueAt        DateTime?              @db.Timestamptz(6)
  status       PlanningTaskStatus     @default(NOT_STARTED)
  completedAt  DateTime?              @db.Timestamptz(6)
  position     Int                    @default(0)
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)

  @@index([checklistId, status, dueAt])
  @@index([assignedToId, status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  UserRole
  method     String
  route      String
  resourceId String?
  statusCode Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model CrmCustomer {
  id                     String                          @id @default(uuid()) @db.Uuid
  organizerId            String                          @db.Uuid
  organizer              User                            @relation("CrmCustomerOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  email                  String
  normalizedEmail        String
  firstName              String
  lastName               String
  phone                  String?
  birthday               DateTime?                       @db.Date
  profileImageUrl        String?
  status                 CrmCustomerStatus               @default(ACTIVE)
  marketingConsent       Boolean                         @default(false)
  marketingConsentAt     DateTime?                       @db.Timestamptz(6)
  marketingConsentSource String?
  registrations          EventRegistration[]
  tags                   CrmCustomerTagAssignment[]
  notes                  CrmCustomerNote[]
  activities             CrmCustomerActivity[]
  segmentMemberships     CrmCustomerSegmentMembership[]
  reminders              CrmCustomerReminder[]
  communications         CrmCommunicationRecord[]
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(6)

  @@unique([organizerId, normalizedEmail])
  @@index([organizerId, status, createdAt])
  @@index([organizerId, lastName, firstName])
}

model CrmCustomerNote {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @db.Uuid
  customer   CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String?     @db.Uuid
  author     User?       @relation("CrmCustomerNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content    String
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(6)

  @@index([customerId, createdAt])
}

model CrmCustomerActivity {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @db.Uuid
  customer   CrmCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  actorId    String?        @db.Uuid
  actor      User?          @relation("CrmCustomerActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventId    String?        @db.Uuid
  event      Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  type       CrmActivityType
  summary    String
  metadata   Json?          @db.JsonB
  sourceKey  String?        @unique
  occurredAt DateTime       @default(now()) @db.Timestamptz(6)

  @@index([customerId, occurredAt])
  @@index([eventId, occurredAt])
}

model CrmCustomerTag {
  id          String                     @id @default(uuid()) @db.Uuid
  organizerId String                     @db.Uuid
  organizer   User                       @relation("CrmCustomerTagOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  name        String
  color       String                     @default("indigo")
  customers   CrmCustomerTagAssignment[]
  createdAt   DateTime                   @default(now()) @db.Timestamptz(6)

  @@unique([organizerId, name])
  @@index([organizerId, name])
}

model CrmCustomerTagAssignment {
  customerId String         @db.Uuid
  customer   CrmCustomer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String         @db.Uuid
  tag        CrmCustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now()) @db.Timestamptz(6)

  @@id([customerId, tagId])
  @@index([tagId, customerId])
}

model CrmCustomerSegment {
  id          String                          @id @default(uuid()) @db.Uuid
  organizerId String                          @db.Uuid
  organizer   User                            @relation("CrmCustomerSegmentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  createdById String?                         @db.Uuid
  createdBy   User?                           @relation("CrmCustomerSegmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  description String?
  criteria    Json                            @db.JsonB
  isSystem    Boolean                         @default(false)
  memberships CrmCustomerSegmentMembership[]
  createdAt   DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                        @updatedAt @db.Timestamptz(6)

  @@unique([organizerId, name])
  @@index([organizerId, isSystem, name])
}

model CrmCustomerSegmentMembership {
  segmentId  String             @db.Uuid
  segment    CrmCustomerSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  customerId String             @db.Uuid
  customer   CrmCustomer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  matchedAt  DateTime           @default(now()) @db.Timestamptz(6)

  @@id([segmentId, customerId])
  @@index([customerId, segmentId])
}

model CrmCustomerReminder {
  id           String            @id @default(uuid()) @db.Uuid
  customerId   String            @db.Uuid
  customer     CrmCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById  String            @db.Uuid
  createdBy    User              @relation("CrmCustomerReminderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId String?           @db.Uuid
  assignedTo   User?             @relation("CrmCustomerReminderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  dueAt        DateTime          @db.Timestamptz(6)
  status       CrmReminderStatus @default(PENDING)
  completedAt  DateTime?         @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)

  @@index([customerId, dueAt, status])
  @@index([assignedToId, dueAt, status])
}

model CrmCommunicationRecord {
  id          String                     @id @default(uuid()) @db.Uuid
  customerId  String                     @db.Uuid
  customer    CrmCustomer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdById String?                    @db.Uuid
  createdBy   User?                      @relation("CrmCommunicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  channel     CrmCommunicationChannel
  direction   CrmCommunicationDirection
  status      CrmCommunicationStatus     @default(RECORDED)
  subject     String?
  summary     String
  providerId  String?
  occurredAt  DateTime                   @default(now()) @db.Timestamptz(6)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(6)

  @@index([customerId, occurredAt])
  @@index([status, occurredAt])
}
