# Local configuration template. Copy to the repository root as .env for
# Compose interpolation, and to apps/api/.env for NestJS/Prisma local runs.
# Replace every local URL/secret for production; this file contains no credentials.

# Prisma runtime connection and direct migration connection. For local Docker,
# both target the same PostgreSQL instance. In production, DIRECT_URL should be
# the provider's direct (non-pooled) connection when DATABASE_URL is pooled.
DATABASE_URL="postgresql://eventhub:eventhub_local@localhost:5433/eventhub?schema=public"
DIRECT_URL="postgresql://eventhub:eventhub_local@localhost:5433/eventhub?schema=public"

# Browser origin allowed to use the API's credentialed auth cookie.
# Production: HTTPS origin only, with no path.
WEB_ORIGIN="http://localhost:3000"

# API session signing and encrypted email-outbox payload protection.
# Production: separate unique high-entropy values, at least 32 characters each.
JWT_SECRET="replace-this-local-placeholder-with-a-long-random-secret"
EMAIL_ENCRYPTION_KEY="replace-this-with-a-separate-long-random-secret"

# Optional seed input. Required only when creating the initial Super Admin.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Resend delivery and signed webhook processing.
# Production: required; use a verified sender domain and Resend webhook secret.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_WEBHOOK_SECRET=""

# Redis queue and rate-limit storage. Production: required, use rediss:// when
# the managed Redis provider requires TLS.
REDIS_URL="redis://localhost:6379"

# Web build/runtime URLs. NEXT_PUBLIC_API_URL is embedded in the browser bundle;
# API_INTERNAL_URL is the server-side web-to-API URL (Docker uses http://api:4000).
NEXT_PUBLIC_API_URL="http://localhost:4000"
API_INTERNAL_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# API process settings. PORT defaults to 4000; TRUST_PROXY should match the
# number/range of trusted reverse proxies when rate limiting behind a proxy.
NODE_ENV="development"
PORT="4000"
TRUST_PROXY=""
