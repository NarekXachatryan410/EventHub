SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
NAVIGATOR_API_URL=""
NAVIGATOR_API_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
REDIS_URL="redis://localhost:6379"
