{
  "name": "eventhub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=api",
    "test:e2e": "npm run test:e2e --workspace=api",
    "db:generate": "npm run db:generate --workspace=api",
    "db:migrate": "npm run db:migrate:dev --workspace=api",
    "db:studio": "npm run db:studio --workspace=api"
  }
}
